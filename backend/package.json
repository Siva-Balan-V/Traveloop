{
  "name": "traveloop-backend",
  "version": "1.0.0",
  "description": "Traveloop Travel Planning Platform - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:setup": "psql -U postgres -f ../database/schema.sql",
    "db:seed": "psql -U postgres -f ../database/seed.sql",
    "lint": "eslint src/**/*.js"
  },
  "keywords": [
    "travel",
    "planning",
    "itinerary",
    "trip",
    "budget"
  ],
  "author": "Traveloop Team",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
